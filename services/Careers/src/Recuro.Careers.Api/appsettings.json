{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "careers"
  },
  "ConnectionStrings": {
    "careers": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Services": {
    "Candidate": {
      "BaseUrl": "http://localhost:5107/",
      "Timeout": "00:00:05"
    },
    "Pipeline": {
      "BaseUrl": "http://localhost:5108/",
      "Timeout": "00:00:05"
    },
    "Config": {
      "BaseUrl": "http://localhost:5102/",
      "Timeout": "00:00:03"
    }
  },
  "Careers": {
    "IjpWindowWorkingDays": 5,
    "ConsentTextVersion": "v1",
    "SearchCacheFor": "00:01:00",
    "DefaultPageSize": 20,
    "MaxPageSize": 50
  }
}
