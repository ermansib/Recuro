{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "reporting"
  },
  "ConnectionStrings": {
    "reporting": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Services": {
    "Config": "",
    "Identity": "",
    "Timeout": "00:00:10"
  },
  "Reporting": {
    "DefaultTimeZone": "UTC"
  },
  "ReportSchedule": {
    "Enabled": true,
    "Interval": "01:00:00"
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
