{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/workflow.task.created.v1.schema.json",
  "title": "workflow.task.created.v1",
  "description": "An approval task opened in an inbox (RCU-WFL-001). Subject: WorkflowTask/{taskId}.",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "description": "Workflow kind, e.g. MRF, Offer."
    },
    "subjectType": {
      "type": "string"
    },
    "subjectId": {
      "type": "string"
    },
    "assignee": {
      "type": "string",
      "description": "Assignee role."
    },
    "dueAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "configVersionId": {
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "instanceId",
    "type",
    "subjectType",
    "subjectId",
    "assignee",
    "configVersionId"
  ],
  "additionalProperties": true
}
