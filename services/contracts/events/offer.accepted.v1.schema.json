{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/offer.accepted.v1.schema.json",
  "title": "offer.accepted.v1",
  "description": "Producer: Offer. The candidate accepted (RCU-OFR-006). Pipeline moves the application to Pre-boarding; Onboarding starts pre-boarding. joiningDate is the offer's joining date. Subject: Offer/<offerId>.",
  "type": "object",
  "properties": {
    "offerId": {
      "type": "string",
      "format": "uuid"
    },
    "appId": {
      "type": "string"
    },
    "reqId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "joiningDate": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD; optional."
    }
  },
  "required": [
    "appId"
  ],
  "additionalProperties": true
}
