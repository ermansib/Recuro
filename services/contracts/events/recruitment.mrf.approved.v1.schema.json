{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/recruitment.mrf.approved.v1.schema.json",
  "title": "recruitment.mrf.approved.v1",
  "description": "The MRF's approval workflow ended: approved; sourcing unlocks (RCU-REQ-004). Subject: Requisition/{reqId}.",
  "type": "object",
  "properties": {
    "reqId": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "configVersionId": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "description": "Requisition state (FRD §6)."
    },
    "to": {
      "type": "string",
      "description": "Requisition state (FRD §6)."
    }
  },
  "required": [
    "reqId",
    "decision",
    "configVersionId",
    "from",
    "to"
  ],
  "additionalProperties": true
}
