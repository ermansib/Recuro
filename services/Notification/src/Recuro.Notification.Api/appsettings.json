{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "notification"
  },
  "ConnectionStrings": {
    "notification": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Email": {
    "FromAddress": "no-reply@recuro.local",
    "FromName": "Recuro",
    "Signature": "Recuro Recruitment (automated)",
    "RetryBackoff": "00:01:00",
    "DownloadBaseUrl": "http://localhost:5100/"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "Auto",
    "PortalBaseUrl": "http://localhost:5173/"
  },
  "EmailDispatch": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "ClaimFor": "00:02:00"
  },
  "NotificationStream": {
    "HeartbeatInterval": "00:00:15",
    "ClientRetry": "00:00:05"
  },
  "Services": {
    "Candidate": {
      "BaseUrl": "http://localhost:5107/",
      "Timeout": "00:00:05"
    },
    "Identity": {
      "BaseUrl": "http://localhost:5101/",
      "Timeout": "00:00:05"
    }
  }
}
