{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "audit"
  },
  "ConnectionStrings": {
    "audit": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AuditSeal": {
    "Enabled": true,
    "Interval": "1.00:00:00"
  }
}
