{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "interview"
  },
  "ConnectionStrings": {
    "interview": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Services": {
    "Config": "",
    "Identity": "",
    "Requisition": "",
    "Workflow": "",
    "Timeout": "00:00:10"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "FeedbackSla": {
    "Enabled": true,
    "Interval": "00:05:00"
  }
}
