{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "pipeline"
  },
  "ConnectionStrings": {
    "pipeline": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Services": {
    "Candidate": {
      "BaseUrl": "http://localhost:5107/",
      "Timeout": "00:00:05"
    }
  },
  "Pipeline": {
    "RegretWorkingDays": 3,
    "RetentionDays": 365
  },
  "TatScan": {
    "Enabled": true,
    "Interval": "00:05:00"
  }
}
