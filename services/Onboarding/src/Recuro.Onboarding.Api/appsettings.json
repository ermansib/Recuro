{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "onboarding"
  },
  "ConnectionStrings": {
    "onboarding": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Services": {
    "Config": "",
    "Candidate": "",
    "Timeout": "00:00:05",
    "CacheFor": "00:05:00"
  },
  "MilestoneScheduler": {
    "Enabled": true,
    "Interval": "00:15:00"
  },
  "DocumentStorage": {
    "RootPath": "data/onboarding-documents",
    "ActiveKeyId": "",
    "Keys": {}
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 11534336
    }
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
