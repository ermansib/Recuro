{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "candidate"
  },
  "ConnectionStrings": {
    "candidate": "",
    "rabbitmq": "",
    "redis": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Pii": {
    "ActiveKeyId": "",
    "Keys": {},
    "BlindIndexKey": ""
  },
  "ResumeStorage": {
    "RootPath": "data/resumes"
  },
  "Retention": {
    "UnsuccessfulRetentionDays": 365
  },
  "RetentionPurge": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "DryRun": false
  }
}
