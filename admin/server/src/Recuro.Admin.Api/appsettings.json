{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "SeedDemoTenants": false
  },
  "ConnectionStrings": {
    "AdminDb": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "recuro-admin-api",
    "ClientId": "recuro-admin",
    "RoleClaim": "roles"
  },
  "AccountDirectory": {
    "Mode": "Keycloak",
    "BaseUrl": "",
    "Realm": "recuro",
    "ClientId": "recuro-admin-provisioner",
    "ClientSecret": "",
    "OwnerAdminRole": "tenant-admin"
  },
  "SignUp": {
    "DefaultLocale": "en-IN",
    "DefaultCurrency": "INR",
    "PermitsPerWindow": 10,
    "WindowMinutes": 15
  }
}
